# Copy to .env (gitignored). Do not commit secrets.
# First visit mints a guest cookie. Chat/SQL/Azure stay off until you fill keys below.

# Cookie signing. Compose defaults to the placeholder if unset — change it if you expose the port.
SIH_SECRET_KEY=

# Optional role lists. Empty + SIH_REQUIRE_ROLES=false (compose default): every guest is a maintainer.
# Managers can commit Azure CSV. Maintainers can chat / prepare.
SIH_REQUIRE_ROLES=false
SIH_MANAGERS=
SIH_MAINTAINERS=

# HTTPS production only. Local HTTP compose must stay false.
BACKEND_SESSION_COOKIE_SECURE=false

# Shared OpenRouter (all users). Empty = chat catalog has no OpenRouter models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional local OpenAI-compatible (vLLM). Compose rewrites 127.0.0.1 → host.docker.internal.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional read-only Postgres. Empty = SQL tools fail until set.
UPSTREAM_DB_HOST=
UPSTREAM_DB_PORT=6432
UPSTREAM_CONNECT_TIMEOUT=90
UPSTREAM_HUB_DBNAME=hub
UPSTREAM_HUB_USER=
UPSTREAM_HUB_PASSWORD=
UPSTREAM_DSPACE_DBNAME=dspace
UPSTREAM_DSPACE_USER=
UPSTREAM_DSPACE_PASSWORD=

# Durable saved SQL (notes + SELECT). Default in code is :memory: (tests).
# Local uvicorn: a file in the process cwd. Compose sets /data/sidecar.sqlite.
SIH_SQLITE_PATH=sidecar.sqlite
